<?xml version="1.0"?>
<sdf version="1.6">

  <model name="grasp_object">

    <!-- L'oggetto parte sospeso nel punto di grasp.
         gravity=false serve a non farlo cadere prima dell'attach.
         Il plugin abiliterà la gravità quando viene attaccato. -->
    <static>false</static>

    <link name="object_link">
      <gravity>true</gravity>

      <!-- <inertial>
        <mass>0.15</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial> -->
      <inertial>
        <mass>0.70</mass>
        <inertia>
          <ixx>0.00075</ixx>
          <iyy>0.00075</iyy>
          <izz>0.00075</izz>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyz>0.0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.16 0.16 0.16</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.16 0.16 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>1.0 0.2 0.0 1.0</ambient>
          <diffuse>1.0 0.2 0.0 1.0</diffuse>
        </material>
      </visual>

    </link>
  </model>

</sdf>