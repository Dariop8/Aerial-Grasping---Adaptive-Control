<?xml version="1.0"?>
<robot name="aerial_robot">

  <!-- ===================== -->
  <!-- Materials -->
  <!-- ===================== -->

  <material name="black">
    <color rgba="0.02 0.02 0.02 1"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.2 1.0 1"/>
  </material>

  <material name="red">
    <color rgba="1.0 0.0 0.0 1"/>
  </material>

  <material name="yellow">
    <color rgba="1.0 0.75 0.0 1"/>
  </material>


  <!-- ===================== -->
  <!-- Fixed world frame -->
  <!-- ===================== -->

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 1.0" rpy="0 0 0"/>
  </joint>


  <!-- ===================== -->
  <!-- Base / drone body -->
  <!-- ===================== -->

  <link name="base_link">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2.4"/>
      <inertia
        ixx="0.12" ixy="0.0" ixz="0.0"
        iyy="0.12" iyz="0.0"
        izz="0.20"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.45 0.08"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.45 0.45 0.08"/>
      </geometry>
    </collision>

  </link>


  <!-- ===================== -->
  <!-- Decorative drone arms -->
  <!-- fixed to base_link -->
  <!-- ===================== -->

  <link name="arm_x">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.0002" ixy="0.0" ixz="0.0"
        iyy="0.0060" iyz="0.0"
        izz="0.0060"/>
    </inertial>

    <visual>
      <geometry>
        <box size="0.85 0.04 0.035"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.85 0.04 0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_arm_x" type="fixed">
    <parent link="base_link"/>
    <child link="arm_x"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
  </joint>


  <link name="arm_y">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.0060" ixy="0.0" ixz="0.0"
        iyy="0.0002" iyz="0.0"
        izz="0.0060"/>
    </inertial>

    <visual>
      <geometry>
        <box size="0.04 0.85 0.035"/>
      </geometry>
      <material name="yellow"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.04 0.85 0.035"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_arm_y" type="fixed">
    <parent link="base_link"/>
    <child link="arm_y"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>


  <!-- ===================== -->
  <!-- Simple propellers -->
  <!-- visual only, fixed -->
  <!-- ===================== -->

  <link name="propeller_1">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.09" length="0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.09" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_propeller_1" type="fixed">
    <parent link="base_link"/>
    <child link="propeller_1"/>
    <origin xyz="0.38 0.38 0.07" rpy="0 0 0"/>
  </joint>


  <link name="propeller_2">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.09" length="0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.09" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_propeller_2" type="fixed">
    <parent link="base_link"/>
    <child link="propeller_2"/>
    <origin xyz="-0.38 0.38 0.07" rpy="0 0 0"/>
  </joint>


  <link name="propeller_3">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.09" length="0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.09" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_propeller_3" type="fixed">
    <parent link="base_link"/>
    <child link="propeller_3"/>
    <origin xyz="-0.38 -0.38 0.07" rpy="0 0 0"/>
  </joint>


  <link name="propeller_4">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00004"/>
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.09" length="0.01"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.09" length="0.01"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_propeller_4" type="fixed">
    <parent link="base_link"/>
    <child link="propeller_4"/>
    <origin xyz="0.38 -0.38 0.07" rpy="0 0 0"/>
  </joint>


  <!-- ===================== -->
  <!-- Arm joint 1 -->
  <!-- ===================== -->

  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 -0.08" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20.0" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link1">

    <inertial>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.0010" ixy="0.0" ixz="0.0"
        iyy="0.0010" iyz="0.0"
        izz="0.0005"/>
    </inertial>

    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.10"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.04 0.10"/>
      </geometry>
    </collision>

  </link>


  <!-- ===================== -->
  <!-- Arm joint 2 -->
  <!-- ===================== -->

  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 -0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20.0" velocity="2.0"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link2">

    <inertial>
      <origin xyz="0 0 -0.185" rpy="0 0 0"/>
      <mass value="0.29"/>
      <inertia
        ixx="0.0060" ixy="0.0" ixz="0.0"
        iyy="0.0060" iyz="0.0"
        izz="0.0010"/>
    </inertial>

    <visual>
      <origin xyz="0 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.37"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.37"/>
      </geometry>
    </collision>

  </link>


  <!-- ===================== -->
  <!-- Gripper -->
  <!-- ===================== -->

  <joint name="gripper_joint" type="fixed">
    <parent link="link2"/>
    <child link="gripper"/>
    <origin xyz="0 0 -0.39" rpy="0 0 0"/>
  </joint>

  <link name="gripper">

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia
        ixx="0.0010" ixy="0.0" ixz="0.0"
        iyy="0.0010" iyz="0.0"
        izz="0.0010"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.04 0.04"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.04 0.04"/>
      </geometry>
    </collision>

  </link>


  <!-- ===================== -->
  <!-- ros2_control for Gazebo -->
  <!-- ===================== -->

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint1">
      <command_interface name="effort">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>

    <joint name="joint2">
      <command_interface name="effort">
        <param name="min">-20</param>
        <param name="max">20</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>


  <!-- ===================== -->
  <!-- Gazebo ros2_control plugin -->
  <!-- ===================== -->

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>/home/dario/Desktop/aerial_project/ros2_ws/src/aerial_grasping_description/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>